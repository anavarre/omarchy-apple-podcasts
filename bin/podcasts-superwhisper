#!/usr/bin/bash
# Lets Superwhisper pause the episode while you dictate. Service.qml runs this
# once each time the plugin loads (so right after installing it, and at every
# login); it can also be run by hand. It changes nothing unless it finds the one
# known problem:
#
#   Superwhisper pauses media players through /opt/superwhisper/scripts/
#   media-bridge.py, which starts with `#!/usr/bin/env python3`. When the
#   session PATH puts a Python without PyGObject (`gi`) ahead of the system's,
#   as a global mise or pyenv Python does, the bridge dies on import and
#   Superwhisper silently pauses nothing.
#
# The fix is a systemd drop-in for superwhisper.service that puts /usr/bin
# first in its PATH, followed by the rest of the session PATH; Superwhisper is
# then restarted once it is idle, never mid-dictation. The drop-in is left
# alone, and nothing is written, when Superwhisper is not installed, already
# has a PATH of its own (from this script, the user or its package), no longer
# uses `env python3`, already finds a Python with `gi`, or the system Python
# lacks `gi` too. Remove the drop-in (path below) and run
# `systemctl --user daemon-reload` to undo it.
#
# Exit codes: always 0 unless the drop-in could not be written (1).

set -u
PATH=/usr/bin:/bin; export PATH

unit=superwhisper.service
bridge=/opt/superwhisper/scripts/media-bridge.py
cfg="${XDG_CONFIG_HOME:-}"; case "$cfg" in /*) ;; *) cfg="$HOME/.config" ;; esac
dir="$cfg/systemd/user/$unit.d"
dropin="$dir/omarchy-apple-podcasts-python.conf"

say() { printf 'podcasts-superwhisper: %s\n' "$1" >&2; }

[ -f "$bridge" ] || exit 0
head -n1 "$bridge" | grep -qx '#!/usr/bin/env python3' || exit 0
command -v systemctl > /dev/null || exit 0
systemctl --user cat "$unit" > /dev/null 2>&1 || exit 0
# A PATH set for the unit already, by anyone, is respected as is.
systemctl --user show -p Environment --value "$unit" 2> /dev/null | grep -qE '(^| )"?PATH=' && exit 0

# The PATH the service inherits is the user manager's.
spath=$(systemctl --user show-environment 2> /dev/null | sed -n 's/^PATH=//p')
[ -n "$spath" ] || exit 0
(cd "$HOME" 2> /dev/null; env PATH="$spath" python3 -c 'import gi' > /dev/null 2>&1) && exit 0
/usr/bin/python3 -c 'import gi' > /dev/null 2>&1 || exit 0

# /usr/bin first, then the session's own entries, minus any a systemd
# Environment= line could misread (only plain absolute paths are kept).
newpath=/usr/bin:/bin
IFS=: read -r -a parts <<< "$spath"
for p in "${parts[@]}"; do
  case "$p" in /*) ;; *) continue ;; esac
  case "$p" in *[!A-Za-z0-9/._+-]*) continue ;; esac
  case ":$newpath:" in *":$p:"*) continue ;; esac
  newpath="$newpath:$p"
done

[ -L "$dir" ] && { say "refusing $dir: it is a symlink"; exit 1; }
mkdir -p "$dir" || { say "could not create $dir"; exit 1; }
t=$(mktemp "$dir/.omarchy-apple-podcasts.XXXXXX") || { say "could not write in $dir"; exit 1; }
if ! printf '%s\n' \
  '# Written by the Apple Podcasts Omarchy plugin (bin/podcasts-superwhisper).' \
  "# Superwhisper's media-bridge.py runs \`env python3\`, and the session PATH" \
  '# finds a Python without PyGObject first, so Superwhisper could not pause' \
  '# media while dictating. /usr/bin goes first for this service only.' \
  '# Delete this file and run `systemctl --user daemon-reload` to undo it.' \
  '[Service]' \
  "Environment=\"PATH=$newpath\"" > "$t" || ! chmod 644 "$t" || ! mv -f "$t" "$dropin"; then
  rm -f "$t"; say "could not write $dropin"; exit 1
fi
systemctl --user daemon-reload || exit 0
say "wrote $dropin"

# Restart it so the new PATH takes effect, but only between dictations: wait
# up to ten minutes for it to be idle. Not running means nothing to restart.
systemctl --user is-active -q "$unit" || exit 0
for _ in $(seq 120); do
  if timeout 5 /usr/bin/superwhisper status 2> /dev/null | grep -q '"phase":"idle"'; then
    systemctl --user try-restart "$unit" && say "restarted $unit"
    exit 0
  fi
  sleep 5
done
say "Superwhisper stayed busy; the fix applies the next time it starts"
exit 0
